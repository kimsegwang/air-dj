# 노트북 플레이어 agent 설정. 이 파일을 agent/.env로 복사해 값을 채운다. agent/.env는 커밋하지 않는다.

# 브로커 = 라즈베리파이 IP (노트북 개발용 브로커면 localhost)
MQTT_HOST=
MQTT_PORT=1883
COMMANDS_TOPIC=air-dj/commands

# 음악 폴더 처음 기본값 (비워 둬도 된다). 대시보드 [폴더 선택]으로 고르면 agent/settings.json이 우선한다.
MUSIC_DIR=
# mpv.exe 경로 (PATH에 있으면 mpv)
MPV_PATH=mpv
MPV_PIPE=\\.\pipe\air-dj-mpv

# 대시보드 (http://localhost:<포트>/). 보드 주소는 카메라 영상/손 박스용 (예: http://192.168.0.20)
BOARD_URL=
GESTURE_TOPIC=air-dj/gesture
DASHBOARD_PORT=8080
OPEN_BROWSER=1
